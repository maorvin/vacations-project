# העתיקו לקובץ בשם .env באותה תיקייה ומלאו ערכים. אל תעלו את .env ל-git.
#   cp Backend/.env.example Backend/.env

# מפתח סודי לחתימת טוקנים. מחרוזת אקראית ארוכה, למשל הפלט של:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# אם ריק, השרת ייצור מפתח אקראי בכל הפעלה (המשתמשים יתנתקו אחרי כל הפעלה מחדש).
JWT_SECRET=

# מפתח ל-Gemini (AI). אפשר להשיג ב-https://aistudio.google.com/apikey
# אם ריק, כל המערכת עובדת חוץ מהמלצות ה-AI והשאלות על החופשות.
GEMINI_API_KEY=

# להרצה מקומית בלי דוקר (npm run dev) בלבד. בדוקר הכתובת נקבעת ב-docker-compose.yml
DATABASE_URL=postgres://vacations:vacations@localhost:5432/vacations
PORT=5001
